Функция ПолучитьУслугиПоНоменклатуре(Номенклатура)
	СписокУслуг = Новый("СписокЗначений");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КВП_Услуги.Ссылка КАК Ссылка,
	|	КВП_Услуги.Услуга КАК Услуга
	|ИЗ
	|	Справочник.КВП_Услуги КАК КВП_Услуги
	|ГДЕ
	|	КВП_Услуги.Услуга = &вхНоменклатура
	|	И НЕ КВП_Услуги.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("вхНоменклатура", Номенклатура); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокУслуг.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокУслуг;
КонецФункции // ()

Функция ПолучитьЗначениеТарифа(Знач ЗданиеПомещение, Знач Услуга, Знач НаДату) Экспорт
	сзУслуг = Новый("СписокЗначений");
	сзУслуг = ПолучитьУслугиПоНоменклатуре(Услуга);
	
	Если сзУслуг.Количество() = 0 Тогда
		РезультатФункции = 0;
		Возврат РезультатФункции;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	КВП_ТарифыСрезПоследних.Услуга КАК Услуга,
	               |	КВП_ТарифыСрезПоследних.Период КАК Период,
	               |	КВП_ТарифыСрезПоследних.Регистратор КАК Регистратор,
	               |	КВП_ТарифыСрезПоследних.НомерСтроки КАК НомерСтроки,
	               |	КВП_ТарифыСрезПоследних.Активность КАК Активность,
	               |	КВП_ТарифыСрезПоследних.Организация КАК Организация,
	               |	КВП_ТарифыСрезПоследних.ВидТарифа КАК ВидТарифа,
	               |	КВП_ТарифыСрезПоследних.Объект КАК Объект,
	               |	КВП_ТарифыСрезПоследних.Тариф КАК ЗначениеТарифа,
	               |	КВП_ТарифыСрезПоследних.Действует КАК Действует
	               |ИЗ
	               |	РегистрСведений.КВП_Тарифы.СрезПоследних(
	               |			КОНЕЦПЕРИОДА(&НаДату, МЕСЯЦ),
	               |			Объект = &вхОбъект
	               |				И Услуга В (&вхУслуга)
	               |				И ВидТарифа = ЗНАЧЕНИЕ(перечисление.КВП_ВидыТарифов.Общий)) КАК КВП_ТарифыСрезПоследних
	               |ГДЕ
	               |	КВП_ТарифыСрезПоследних.Действует
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Услуга,
	               |	Период";
	
	Запрос.УстановитьПараметр("вхОбъект", ЗданиеПомещение); 
	//Запрос.УстановитьПараметр("вхОрганизация", Организация); 
	
	Запрос.УстановитьПараметр("вхУслуга", сзУслуг); 
	Запрос.УстановитьПараметр("НаДату", НаДату);
	
	РезультатФункции = 0;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		РезультатФункции = Выборка.ЗначениеТарифа;
	КонецЦикла;
	
    Возврат РезультатФункции;
КонецФункции

