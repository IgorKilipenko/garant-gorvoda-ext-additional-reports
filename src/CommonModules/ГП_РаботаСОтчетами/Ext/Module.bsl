// Гарант+ Килипенко 03.02.2025 [F00234067] Отчет Потребление по нормам ++
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений
//      * ЛицевойСчет - СправочникСсылка.КВП_ЛицевыеСчета
//      * __КоличествоЖильцов__ - Число - Имя колонки определяется параметром `ИмяКолонкиКоличества`
//  ИмяКолонкиКоличества - Строка
// Возвращаемое значение:
//  - Число - Сумма количества жильцов
Функция РасчитатьСуммуЖильцовПоЛицевымСчетам(Знач ТаблицаДанных, Знач ИмяКолонкиКоличества) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = ГП_РаботаСОтчетамиПовтИсп.ПолучитьТекстЗапросаКоличестваЖильцовПоЛицевымСчетам(ИмяКолонкиКоличества);

    Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
    РезультатЗапроса = Запрос.Выполнить();

    РезультатФункции = 0;
    Выборка = РезультатЗапроса.Выбрать();
    
    Если Выборка.Следующий() Тогда
    	РезультатФункции = Выборка.Сумма;
    КонецЕсли;

    Возврат РезультатФункции;
КонецФункции // Гарант+ Килипенко 03.02.2025 [F00234067] Отчет Потребление по нормам --

