// Параметры:
//  ПараметрыЗаполнения - Структура
//      * ДатаНачала - Дата
//      * ДатаОкончания - Дата
//      * ДатаАктуальности - Дата
//      * НоменклатурнаяГруппа - СправочникСсылка.НоменклатурныеГруппы
// Возвращаемое значение:
//  - ТаблицаЗначений
//      * НазначениеПлатежа - Строка
//      * Контрагент - СправочникСсылка.Контрагенты
//      * Договор - СправочникСсылка.ДоговорыКонтрагентов
//      * ЛицевойСчет - СправочникСсылка.КВП_ЛицевыеСчета
//      * Номенклатура - СправочникСсылка.Номенклатура
Функция ПолучитьДанныеЗаполненияТаблицыСоответствий(Знач ПараметрыЗаполнения) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
        |	РеализацияУслуг.Содержание КАК НазначениеПлатежа,
        |	РеализацияУслуг.Ссылка.Контрагент КАК Контрагент,
        |	РеализацияУслуг.Ссылка.ДоговорКонтрагента КАК Договор,
        |	РеализацияУслуг.Номенклатура КАК Номенклатура
        |ПОМЕСТИТЬ ВТ_Реализация
        |ИЗ
        |	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияУслуг
        |ГДЕ
        |	РеализацияУслуг.Ссылка.Проведен = ИСТИНА
        |	И РеализацияУслуг.Ссылка = &Ссылка
        |	И РеализацияУслуг.Номенклатура = &Номенклатура
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	СведенияДляВзаиморасчетовПоЛС.Период КАК Период,
        |	СведенияДляВзаиморасчетовПоЛС.ЛицевойСчет КАК ЛицевойСчет,
        |	СведенияДляВзаиморасчетовПоЛС.ЛицевойСчет.Адрес.Владелец КАК Здание,
        |	СведенияДляВзаиморасчетовПоЛС.ЛицевойСчет.Адрес.Владелец.Наименование КАК Адрес,
        |	СведенияДляВзаиморасчетовПоЛС.Договор КАК Договор,
        |	СведенияДляВзаиморасчетовПоЛС.Контрагент КАК Контрагент
        |ИЗ
        |	РегистрСведений.УПЖКХ_СведенияДляВзаиморасчетовПоЛС КАК СведенияДляВзаиморасчетовПоЛС
        |ГДЕ
        |	СведенияДляВзаиморасчетовПоЛС.Активность = ИСТИНА
        |	И СведенияДляВзаиморасчетовПоЛС.Контрагент В
        |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
        |				Т.Контрагент
        |			ИЗ
        |				ВТ_Реализация КАК Т)
        |	И СведенияДляВзаиморасчетовПоЛС.ЛицевойСчет = &ЛицевойСчет
        |
        |УПОРЯДОЧИТЬ ПО
        |	СведенияДляВзаиморасчетовПоЛС.Период УБЫВ
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ВТ_Реализация.НазначениеПлатежа КАК НазначениеПлатежа,
        |	ВТ_Реализация.Контрагент КАК Контрагент,
        |	ВТ_Реализация.Договор КАК Договор,
        |	ВТ_Реализация.Номенклатура КАК Номенклатура
        |ИЗ
        |	ВТ_Реализация КАК ВТ_Реализация";

    ДатаАктуальности = ?(ПараметрыЗаполнения.Свойство("ДатаАктуальности"), ПараметрыЗаполнения.ДатаАктуальности, Неопределено);

    //Запрос.УстановитьПараметр("НоменклатурнаяГруппа", ПараметрыЗаполнения.НоменклатурнаяГруппа);
	Запрос.УстановитьПараметр("Номенклатура", ПараметрыЗаполнения.НоменклатурнаяГруппа);
    //Запрос.УстановитьПараметр("ДатаНачала", ПараметрыЗаполнения.ДатаНачала);
    //Запрос.УстановитьПараметр("ДатаОкончания", ПараметрыЗаполнения.ДатаОкончания);
	Запрос.УстановитьПараметр("Ссылка", ПараметрыЗаполнения.Регистратор);
	Запрос.УстановитьПараметр("ЛицевойСчет", ПараметрыЗаполнения.ЛицевойСчет);
	
    Если ДатаАктуальности <> Неопределено Тогда
        Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
    Иначе
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаАктуальности", "");
    КонецЕсли;

    РезультатПакетаЗапроса = Запрос.ВыполнитьПакет();
    ТаблицаПредварительныхДанных = РезультатПакетаЗапроса[2].Выгрузить();
    СведенияДляВзаиморасчетовПоЛС = РезультатПакетаЗапроса[1].Выгрузить();

    СведенияДляВзаиморасчетовПоЛС.Индексы.Добавить("Договор, Контрагент");
    ТаблицаПредварительныхДанных = СопоставитьДанные(
            ТаблицаПредварительныхДанных, СведенияДляВзаиморасчетовПоЛС, ПараметрыЗаполнения.НоменклатурнаяГруппа);

    РезультатФункции = ДополнитьДаннымиРанееВведенныхСоответствий(ТаблицаПредварительныхДанных, ДатаАктуальности);
    Возврат РезультатФункции;
КонецФункции

// Параметры:
//  ТаблицаДанных - ТаблицаЗначений
//      * НазначениеПлатежа - Строка
//      * Контрагент - СправочникСсылка.Контрагенты
//      * Договор - СправочникСсылка.ДоговорыКонтрагентов
//      * ЛицевойСчет - СправочникСсылка.КВП_ЛицевыеСчета
//      * Номенклатура - СправочникСсылка.Номенклатура
//  ДатаАктуальности - Дата, Неопределено
// Возвращаемое значение:
//  - ТаблицаЗначений
//      * НазначениеПлатежа - Строка
//      * Контрагент - СправочникСсылка.Контрагенты
//      * Договор - СправочникСсылка.ДоговорыКонтрагентов
//      * ЛицевойСчет - СправочникСсылка.КВП_ЛицевыеСчета
//      * Номенклатура - СправочникСсылка.Номенклатура
Функция ДополнитьДаннымиРанееВведенныхСоответствий(Знач ТаблицаДанных, Знач ДатаАктуальности = Неопределено)
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   *
        |ПОМЕСТИТЬ ВТ_ТаблицаДанных
        |ИЗ
        |   &ТаблицаДанных КАК ТаблицаДанных
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   *
        |ПОМЕСТИТЬ ВТ_СоответствияНазначенийПлатежей
        |ИЗ
        |   РегистрСведений.ГП_СоответствияНазначенийПлатежей.СрезПоследних(&ДатаАктуальности) КАК СоответствияНазначенийПлатежей
        |ГДЕ
        |   (Контрагент, Договор) В (ВЫБРАТЬ Т.Контрагент, Т.Договор ИЗ ВТ_ТаблицаДанных КАК Т)
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   ВТ_ТаблицаДанных.НазначениеПлатежа КАК НазначениеПлатежа,
        |   ВТ_ТаблицаДанных.Контрагент КАК Контрагент,
        |   ВТ_ТаблицаДанных.Договор КАК Договор,
        |   ЕСТЬNULL(ВТ_СоответствияНазначенийПлатежей.ЛицевойСчет, ВТ_ТаблицаДанных.ЛицевойСчет) КАК ЛицевойСчет,
        |   ВТ_ТаблицаДанных.Номенклатура КАК Номенклатура
        |ИЗ
        |   ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
        |   ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СоответствияНазначенийПлатежей КАК ВТ_СоответствияНазначенийПлатежей
        |   ПО ВТ_ТаблицаДанных.Контрагент = ВТ_СоответствияНазначенийПлатежей.Контрагент
        |   И ВТ_ТаблицаДанных.ЛицевойСчет = ЗНАЧЕНИЕ(Справочник.КВП_ЛицевыеСчета.ПустаяСсылка)
        |   И ВТ_ТаблицаДанных.Договор = ВТ_СоответствияНазначенийПлатежей.Договор
        |   И ВТ_ТаблицаДанных.НазначениеПлатежа = ВТ_СоответствияНазначенийПлатежей.НазначениеПлатежа
        |";

    Если ДатаАктуальности = Неопределено Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаАктуальности", "");
    Иначе
        Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
    КонецЕсли;
    Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);

    РезультатЗапроса = Запрос.Выполнить();
    РезультатФункции = РезультатЗапроса.Выгрузить();
    Возврат РезультатФункции;
КонецФункции

Функция СопоставитьДанные(Знач ТаблицаПредварительныхДанных, Знач СведенияДляВзаиморасчетовПоЛС, Знач НоменклатурнаяГруппа)
    КлючиПоискаЛС = "Договор, Контрагент";

    РезультатФункции = ТаблицаПредварительныхДанных.Скопировать();
    РезультатФункции.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.КВП_ЛицевыеСчета"));

    СоответствиеПсевдонимовНоменклатурныхГрупп = ПолучитьСоответствиеПсевдонимовНоменклатурныхГрупп();

    КэшШаблоновЗаменыНаименованийНоменклатур = Новый Соответствие;
    Для Каждого СтрокаДанных Из РезультатФункции Цикл
        КлючКэшаНоменклатуры = ?(ЗначениеЗаполнено(СтрокаДанных.Номенклатура),
                СтрокаДанных.Номенклатура, НоменклатурнаяГруппа);
        ШаблонЗаменыНоменклатуры = КэшШаблоновЗаменыНаименованийНоменклатур.Получить(КлючКэшаНоменклатуры);
        Если ШаблонЗаменыНоменклатуры = Неопределено Тогда
            ШаблонЗаменыНоменклатуры = ПолучитьШаблонЗаменыСодержанияПоНоменклатуре(СоответствиеПсевдонимовНоменклатурныхГрупп,
                    СтрокаДанных.Номенклатура, НоменклатурнаяГруппа);
            КэшШаблоновЗаменыНаименованийНоменклатур.Вставить(КлючКэшаНоменклатуры,
                ?(ШаблонЗаменыНоменклатуры = Неопределено, "", ШаблонЗаменыНоменклатуры));
        КонецЕсли;

        Если ШаблонЗаменыНоменклатуры = Неопределено ИЛИ ПустаяСтрока(ШаблонЗаменыНоменклатуры) Тогда
            Продолжить;
        КонецЕсли;

        АдресПоиска = ПолучитьСтрокуАдресаИзСодержания(СтрокаДанных.НазначениеПлатежа, ШаблонЗаменыНоменклатуры);
        Если АдресПоиска = Неопределено Тогда
            Продолжить; // Не распознан адрес в строке содержания
        КонецЕсли;

        ЭтоЗданиеПотерьВоды = ГП_МиграцияОбщегоНазначения.ЭтоНаименованиеПотериВоды(АдресПоиска);
        ПоискСНеточнымСовпадением = ЭтоЗданиеПотерьВоды;

        СписокАдресовПоиска = ПодготовитНаименованиеЗданияДляСравнения(АдресПоиска);

        Для Каждого АдресПоиска Из СписокАдресовПоиска Цикл
            // Попытка найти соответствующий л/с
            НайденныйЛицевойСчет = ПопыткаНайтиЛицевойСчетИзДанныхВзаиморасчетов(
                    АдресПоиска,
                    Новый Структура(КлючиПоискаЛС, СтрокаДанных.Договор, СтрокаДанных.Контрагент),
                    СведенияДляВзаиморасчетовПоЛС, ПоискСНеточнымСовпадением);

            Если НайденныйЛицевойСчет = Неопределено Тогда
                // Попытка поиска по Контрагенту (без учета Договора)
                НайденныйЛицевойСчет = ПопыткаНайтиЛицевойСчетИзДанныхВзаиморасчетов(
                        АдресПоиска,
                        Новый Структура("Контрагент", СтрокаДанных.Контрагент),
                        СведенияДляВзаиморасчетовПоЛС,
                        СтрокаДанных.Договор, ПоискСНеточнымСовпадением);
            Иначе
                Прервать;
            КонецЕсли;
        КонецЦикла;

        СтрокаДанных.ЛицевойСчет = НайденныйЛицевойСчет;

    КонецЦикла;

    Возврат РезультатФункции;
КонецФункции

// Возвращаемое значение:
//  - Соответствие
Функция ПолучитьСоответствиеПсевдонимовНоменклатурныхГрупп() Экспорт
    РезультатФункции = Новый Соответствие;

    СтруктураНоменклатуры = ПолучитьНоменклатурнуюГруппуНегативноеВоздействиеНаЦСВ();
    СтруктураНоменклатуры.Вставить("Наименование",
        ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураНоменклатуры.Ссылка, "Наименование"));

    РезультатФункции.Вставить(СтруктураНоменклатуры, "Водоотведение");

    Возврат РезультатФункции;
КонецФункции
Функция ПолучитьНоменклатурнуюГруппуНегативноеВоздействиеНаЦСВ() Экспорт
    Возврат ПолучитьНоменклатурнуюГруппуПоКоду("0000158", Истина);
КонецФункции
// Параметры:
//  Код - Строка
//  ИгнорироватьПомеченныеНаУдаление - Булево
// Возвращаемое значение:
//  - Структура
//      * Ссылка - СправочникСсылка.НоменклатурныеГруппы
//      * Код - Строка
//      * Наименование - Строка
Функция ПолучитьНоменклатурнуюГруппуПоКоду(Знач Код, Знач ИгнорироватьПомеченныеНаУдаление = Истина) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   НоменклатурныеГруппы.Ссылка КАК Ссылка,
        |   НоменклатурныеГруппы.Код КАК Код,
        |   НоменклатурныеГруппы.Наименование КАК Наименование
        |ИЗ
        |   Справочник.НоменклатурныеГруппы КАК НоменклатурныеГруппы
        |ГДЕ
        |   НоменклатурныеГруппы.Код = &Код
        |   И НоменклатурныеГруппы.ПометкаУдаления = ЛОЖЬ
        |";

    Запрос.УстановитьПараметр("Код", Код);
    Если ИгнорироватьПомеченныеНаУдаление = Ложь Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НоменклатурныеГруппы.ПометкаУдаления = ЛОЖЬ", "");
    КонецЕсли;

    РезультатЗапроса = Запрос.Выполнить();
    ТаблицаУслуг = РезультатЗапроса.Выгрузить();

    Если ТаблицаУслуг.Количество() <> 1 Тогда
        ВызватьИсключение(СтрШаблон("Ошибка при получении номенклатурной группы с кодом ""%1"". %2",
                Код,
                ?(ТаблицаУслуг.Количество() > 1, "Код номенклатурной группы не уникален.", "Номенклатурная группа отсутствует в ИБ.")));
    КонецЕсли;

    РезультатФункции = Новый Структура("Ссылка, Код, Наименование");
    ЗаполнитьЗначенияСвойств(РезультатФункции, ТаблицаУслуг[0]);

    Возврат РезультатФункции;
КонецФункции

Функция ПопыткаНайтиЛицевойСчетИзДанныхВзаиморасчетов(
        Знач АдресПоиска, Знач Отбор, Знач СведенияДляВзаиморасчетовПоЛС,
        Знач ИсключаяДоговор = Неопределено, Знач НеточноеСоответствие = Неопределено)

    НеточноеСоответствие = ?(НеточноеСоответствие = Неопределено, Ложь, НеточноеСоответствие);

    НайденныеСтроки = СведенияДляВзаиморасчетовПоЛС.НайтиСтроки(Отбор);
    НайденныйЛицевойСчет = Неопределено;
    Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
        Если НайденнаяСтрока.Договор = ИсключаяДоговор Тогда
            Продолжить;
        КонецЕсли;

        ОчищенныйНайденныйАдрес = ОчиститьАдрес(НайденнаяСтрока.Адрес);
        Если (НеточноеСоответствие = Ложь И ОчищенныйНайденныйАдрес = АдресПоиска)
            ИЛИ СтрНачинаетсяС(ОчищенныйНайденныйАдрес, АдресПоиска) Тогда
            НайденныйЛицевойСчет = НайденнаяСтрока.ЛицевойСчет;
            Возврат НайденныйЛицевойСчет;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции

Функция ОчиститьАдрес(Знач Адрес)
    Адрес = НРег(Адрес);
    Возврат СтрЗаменитьПоРегулярномуВыражению(Адрес, "(?i)[^a-zа-я0-9]+", "");
КонецФункции

// Параметры:
//  НаименованиеЗдания - Строка
// Возвращаемое значение:
//  - Массив из Строка
Функция ПодготовитНаименованиеЗданияДляСравнения(Знач НаименованиеЗдания)
    РезультатФункции = Новый Массив;

    Если ГП_МиграцияОбщегоНазначения.ЭтоНаименованиеУслугиНегативногоВоздействия(НаименованиеЗдания) = Истина Тогда
        НаименованиеЗдания = ГП_МиграцияОбщегоНазначения.УдалитьСуффиксНегативногоВоздействия(НаименованиеЗдания);
        РезультатФункции.Добавить(НаименованиеЗдания);
    ИначеЕсли ГП_МиграцияОбщегоНазначения.ЭтоНаименованиеУслугиХолодногоВодоснабженияОИ(НаименованиеЗдания) = Истина Тогда
        РезультатФункции.Добавить(НаименованиеЗдания);
        НаименованиеЗдания = ГП_МиграцияОбщегоНазначения.УдалитьСуффиксХолодногоВодоснабженияОИ(НаименованиеЗдания);
        РезультатФункции.Добавить(НаименованиеЗдания);
    Иначе
        РезультатФункции.Добавить(НаименованиеЗдания);
    КонецЕсли;

    Для Сч = 0 По РезультатФункции.Количество() - 1 Цикл
        РезультатФункции[Сч] = ОчиститьАдрес(РезультатФункции[Сч]);
    КонецЦикла;

    Возврат РезультатФункции;
КонецФункции

Функция ПолучитьСтрокуАдресаИзСодержания(Знач Содержание, Знач ШаблонЗаменыНоменклатуры)
    // Удаление показаний счетчиков из строки содержания
    РезультатУдаленияПоказаний = ГП_ПриборыУчета_.УдалитьПоказанияСчетчиковИзСтроки(Содержание);
    Если РезультатУдаленияПоказаний.Успех = Истина Тогда
        Содержание = РезультатУдаленияПоказаний.Значение;
    КонецЕсли;

    // Удаление наименования номенклатуры из строки содержания
    Содержание = СтрЗаменитьПоРегулярномуВыражению(Содержание, ШаблонЗаменыНоменклатуры, "");

    //////////////////////////////////////////////////////////////////////
    // !!! УДАЛИТЬ! Не используется в новом механизме т.к. в содержание теперь записывается только наименование здания
    // Удаляем контрагента из строки содержания (вида: контрагент / здание)
    РезультатУдаленияКонтрагента = ГП_РаботаСЛицевымиСчетами.УдалитьКонтрагентаИзСтрокиНаименованияЛицевогоСчетаПоШаблону(Содержание);
    Если РезультатУдаленияКонтрагента.Успех = Истина Тогда
        Содержание = РезультатУдаленияКонтрагента.Значение;
    КонецЕсли;
    // !!! УДАЛИТЬ!  //////////////
    //////////////////////////////////////////////////////////////////////

    Возврат Содержание;
КонецФункции

Функция ПолучитьШаблонЗаменыСодержанияПоНоменклатуре(
        Знач СоответствиеНаименований, Знач НоменклатураСсылка, Знач НоменклатурнаяГруппаСсылка = Неопределено)

    РезультатФункции = Неопределено;

    Если ТипЗнч(НоменклатураСсылка) = Тип("СправочникСсылка.Номенклатура")
        И НоменклатураСсылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда

        РезультатФункции = СоответствиеНаименований.Получить(НоменклатураСсылка);
        Если РезультатФункции = Неопределено Тогда
            РезультатФункции = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураСсылка, "Наименование"));
        КонецЕсли;
        РезультатФункции = СтрШаблон("^%1,\s", РезультатФункции);

        Возврат РезультатФункции;
    КонецЕсли;

    Если ТипЗнч(НоменклатурнаяГруппаСсылка) <> Тип("СправочникСсылка.НоменклатурныеГруппы") Тогда
        ВызватьИсключение("Не Несоответствие значений параметров");
    КонецЕсли;

    РезультатФункции = СоответствиеНаименований.Получить(НоменклатурнаяГруппаСсылка);
    Если РезультатФункции = Неопределено Тогда
        РезультатФункции = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатурнаяГруппаСсылка, "Наименование"));
    КонецЕсли;
    РезультатФункции = СтрШаблон("^%1\s", РезультатФункции);

    Возврат РезультатФункции;
КонецФункции

#КонецОбласти // СКДРасчеты

