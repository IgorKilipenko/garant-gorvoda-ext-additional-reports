            Иначе
                КэшТекДанных.Вставить(КлючТекСтроки, Истина);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    
    Для Каждого СтрУдаления Из СтрокиРеализацииДляУдаления Цикл
