			//БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаУвеличениеСтоимости,               "ЗаПериод.Стоимость" + СуффиксПоказателя + "Увеличение");
			//БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаУменьшениеСтоимости,               "ЗаПериод.Стоимость" + СуффиксПоказателя + "Уменьшение");
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаНачислениеАмортизации,             "ЗаПериод.Амортизация" + СуффиксАмортизация + "Начисление");  // 9
			//БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаСписаниеАмортизации,               "ЗаПериод.Амортизация" + СуффиксАмортизация + "Списание");
			
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаРасчетнаяАмортизацияПоМаксСПИ,     "ЗаПериод.РасчетнаяАмортизацияПоМаксСПИ");                    // 10
			
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаДанныеНаКонецСтоимость,            "НаКонецПериода.Стоимость" + СуффиксПоказателя + "ОстатокКонПериода");  // 11
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаДанныеНаКонецАмортизация,          "НаКонецПериода.Амортизация" + СуффиксАмортизация + "ОстатокКонПериода"); // 12
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаДанныеНаКонецОстаточнаяСтоимость,  "НаКонецПериода.ОстаточнаяСтоимость" + СуффиксПоказателя + "КонПериода"); // 13
			
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПланируемаяОстаточнаяСтоимостьНа31122022,     "ПланируемаяСтоиимость.ПланируемаяОстаточнаяСтоимостьНа31122022"); // 14
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПланируемаяОстаточнаяСтоимостьНа31122023,     "ПланируемаяСтоиимость.ПланируемаяОстаточнаяСтоимостьНа31122023"); // 15
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаСравнениеОстатСтоимостиНа31122023сРасчетнойАмортЗа2года,     "ПланируемаяСтоиимость.СравнениеОстатСтоимостиНа31122023сРасчетнойАмортЗа2года");  // 16
			БухгалтерскиеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаИтоговаяРасчетнаяАморизацияПоМаксСПИсУчетомОстСтоимости,     "ПланируемаяСтоиимость.ИтоговаяРасчетнаяАморизацияПоМаксСПИсУчетомОстСтоимости");  // 17
